generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String            @id @default(cuid())
  name      String
  email     String            @unique
  phone     String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  loans     LoanApplication[]
  otps      UserOTP[]
}

model UserOTP {
  id        String   @id @default(cuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoanApplication {
  id                String    @id @default(cuid())
  fullName          String
  email             String
  phone             String
  monthlyIncome     Float
  loanAmount        Float
  loanMonths        Int
  purpose           String
  creditScore       Int
  eligibility       Int       @default(0)
  interestRate      Float     @default(0)
  risk              String    @default("PENDING")
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  loanType          LoanType  @default(PERSONAL)
  goldOwnership     String?
  goldPurity        String?
  goldValue         Float?
  goldWeight        Float?
  ownershipStatus   String?
  propertyAddress   String?
  propertyType      String?
  propertyValue     Float?
  propertyDocumentUploadId String?
  paidAt            DateTime?
  paymentAmount     Float?
  paymentStatus     String    @default("NOT_REQUIRED")
  razorpayOrderId   String?
  razorpayPaymentId String?
  userId            String?
  fraudFlags        String?
  fraudRisk         String    @default("LOW")
  fraudScore        Int       @default(0)
  riskReasons       String?
  user              User?     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

enum LoanType {
  PERSONAL
  PROPERTY
  GOLD
}
